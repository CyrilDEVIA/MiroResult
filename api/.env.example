# ─── NOM DE L'APPLICATION ─────────────────────────────────────────────────
APP_NAME=MiroResult

# ─── URLs ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:9903

# ─── GÉNÉRAL ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9904

# ─── BASE DE DONNÉES ────────────────────────────────────────────────────────
DATABASE_URL=file:./prisma/dev.db

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:9903

# ─── UPLOADS ────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads

# ─── RATE LIMITING ──────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000

# ─── Configuration IA ────────────────────────────────────────────────────────
# À compléter via l'interface Settings — ces valeurs sont stockées dans .env.ia
# et ne doivent jamais être committées.
AI_PROVIDER_NAME=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
